{
  "name": "@access0x1/x402-client",
  "version": "0.1.0",
  "description": "IAgentPayer \u2014 the minimal client an agent runtime uses to pay through the Access0x1 rail via x402.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "x402",
    "agent",
    "payments",
    "usdc",
    "eip-3009",
    "ap2"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.5.0",
    "js-yaml": "^4.3.1",
    "minimatch@3": {
      "brace-expansion": "^1.1.18"
    },
    "brace-expansion": "^5.0.9"
  }
}
