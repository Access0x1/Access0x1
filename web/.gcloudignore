# Keep the Cloud Build upload lean — the Docker build re-installs from the
# lockfile and re-builds .next inside the container; none of these belong in
# the source tarball.
.gcloudignore
.git
node_modules/
.next/
# The design-sync bundle (20MB of component screenshots + contact sheets). It is
# a local design-review artifact, gitignored, and nothing in the image reads it —
# but this file REPLACES the .gitignore fallback rather than extending it, so an
# entry ignored by git still uploads unless it is named here.
ds-bundle/
coverage/
playwright-report/
test-results/
e2e/.auth/
*.log
# NO env file ships to the production build — not even .env.example. The build
# gets its public values from cloudbuild substitutions; the runtime gets its env
# from Cloud Run (--env-vars-file) + Secret Manager. The example file is docs,
# and docs have no business inside a production build context.
.env*
