# @access0x1/mcp — environment variable NAMES only (no values, no secrets).
# Copy to .env and fill values there; never commit a real value.
#
# The whole point of this server: no chain address is hardcoded in its code.
# Every router / USDC / feed address comes from the rail's published manifest,
# read at runtime from ONE of the two sources below. Addresses are DATA, not code.

# ── Chain-facts source (REQUIRED — set at least one) ─────────────────────────
# The manifest enumerates chains and their addresses. Prefer a local file; the
# server falls back to the URL when the file is unset or unreadable.
# A local manifest file path (JSON). Highest priority.
ACCESS0X1_MANIFEST_PATH=
# A raw manifest URL (e.g. a raw.githubusercontent.com link). Used when the path
# is unset or fails to load.
ACCESS0X1_MANIFEST_URL=

# ── Indexed history source (OPTIONAL → subgraph tools report dormant) ────────
# A GraphQL endpoint for the rail's payment-history subgraph. When unset, the
# merchant / leaderboard / verify tools return a clear "dormant" result instead
# of failing — the capability is ABSENT, not broken.
ACCESS0X1_SUBGRAPH_URL=

# ── Hosted checkout + agent-pay base (OPTIONAL → those tools report dormant) ──
# The base origin of the rail's web app (hosted checkout + the agent-pay route).
# When unset, checkout_link and agent_pay_request report dormant.
ACCESS0X1_WEB_BASE_URL=

# The shared caller-auth token the agent-pay route checks (its `x-internal-secret`
# header). OPTIONAL. When set, agent_pay_request forwards it so an authenticated
# deployment accepts the call. This is NOT a spending key — the web route owns the
# wallet and the budget; this server never holds either. Never logged, never echoed.
ACCESS0X1_AGENT_INTERNAL_SECRET=
