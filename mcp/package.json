{
  "name": "@access0x1/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the Access0x1 payments rail — an AI agent operates the rail with zero hardcoded chain facts; addresses come from the rail's published manifest at runtime.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "access0x1-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "manifest",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "gate": "npm run typecheck && npm run test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "payments",
    "web3",
    "agents",
    "stablecoin",
    "usdc"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
